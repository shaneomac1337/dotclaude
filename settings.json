{
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File __HOME__/.claude/statusline.ps1"
  },
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File __HOME__/.claude/hooks/skill-forced-eval-hook.ps1"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true
  }
}
